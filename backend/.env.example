# Backend Environment Variables Example
# Convex Cloud or Self-Hosted configuration

# Deployment identifier (set automatically when running `npx convex dev` with Convex Cloud)
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Self-Hosted Convex credentials (if using self-hosted backend)
CONVEX_SELF_HOSTED_URL=https://convex-api.yourdomain.com
CONVEX_SELF_HOSTED_ADMIN_KEY=your-admin-key

# Auth configuration
AUTH_RESEND_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM="Tekyida <auth@yourdomain.com>"
SITE_URL=http://localhost:3000

# Auth JWT configuration (for production/self-hosted)
JWT_PRIVATE_KEY=""
JWKS=""
