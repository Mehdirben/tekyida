# Convex deployment (set automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Convex public URL (your Convex cloud endpoint)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL (used for auth callbacks)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Convex backend auth email variables (set with `npx convex env set`, not in the frontend)
AUTH_RESEND_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM="Tekyida <auth@yourdomain.com>"
