{
  "threshold": 0,
  "minLines": 15,
  "minTokens": 75,
  "reporters": ["console", "json"],
  "output": "tests/reports/duplication",
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/_generated/**",
    "**/build/**",
    "**/dist/**",
    "**/.gradle/**",
    "**/gradlew*",
    "**/gradle/**",
    "**/tests/reports/**",
    "**/package-lock.json",
    "**/.git/**",
    "**/*.md",
    "**/*.mdx",
    "**/docs/**",
    "**/doc/**",
    "**/README*",
    "**/LICENSE*",
    "**/*.txt"
  ],
  "absolute": false
}
